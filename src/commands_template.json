    },
    "hotkey_kill_line": {
        "triggers": {
            "ru": ["удали строку", "сотри строку", "убери строку", "убери набранное", "удали набранное"],
            "en": ["delete line", "remove line"]
        },
        "type": "hotkey",
        "value": "ctrl+u"
    },
    "hotkey_copy": {
        "triggers": {
