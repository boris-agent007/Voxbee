{
    "_comment": "Multilingual voice commands template",
    "_comment2": "triggers can be legacy list or multilingual object: {common:[...], ru:[...], en:[...]}",
    "_comment3": "type: paste/hotkey/mouse_move/mouse_click/mouse_monitor/grid/grid_zoom/mouse_continuous/mouse_stop/focus_switch/focus_save/mouse_scroll/mouse_scroll_max",
    "_comment4": "Reload commands through tray after editing",
    "_comment5": "Grid example: 'сетка 15' / 'grid 15', 'уточни 7' / 'refine 7'",

    "paste_venv": {
        "triggers": {
            "ru": ["включи окружение"],
            "en": ["activate environment"]
        },
        "type": "paste",
        "value": "venv\\Scripts\\activate"
    },
     "run_programm": {
        "triggers": {
            "ru": ["запусти программу"],
            "en": ["activate environment"]
        },
        "type": "paste",
        "value": "source venv/Scripts/activate && python src/main.py"  

    },
    "paste_git_status": {
        "triggers": {
            "ru": ["гит статус", "гид статус"],
            "en": ["git status"]
        },
        "type": "paste",
        "value": "git status"
    },
    "paste_git_push": {
        "triggers": {
            "ru": ["гит пуш" , "git push" , "гид пуш"],
            "en": ["git push"]
        },
        "type": "paste",
        "value": "git push"
    },

    "hotkey_save": {
        "triggers": {
            "ru": ["сохрани", "сохранить"],
            "en": ["save"]
        },
        "type": "hotkey",
        "value": "ctrl+s"
    },
    "hotkey_undo": {
        "triggers": {
            "ru": ["отмени", "отменить"],
            "en": ["undo"]
        },
        "type": "hotkey",
        "value": "ctrl+z"
    },
    "hotkey_redo": {
        "triggers": {
            "ru": ["повтори"],
            "en": ["redo"]
        },
        "type": "hotkey",
        "value": "ctrl+y"
    },
    "hotkey_clear": {
        "triggers": {
